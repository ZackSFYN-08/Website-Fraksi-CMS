{
  "kind": "collectionType",
  "collectionName": "followups",
  "info": {
    "singularName": "followup",
    "pluralName": "followups",
    "displayName": "Aspiration Follow-up",
    "description": "Follow-up status on citizen aspirations"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "aspiration": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::aspiration.aspiration"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "date": {
      "type": "date"
    },
    "followup_status": {
      "type": "enumeration",
      "enum": [
        "pending",
        "progress",
        "done"
      ],
      "required": true,
      "default": "pending"
    }
  }
}